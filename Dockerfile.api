FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CRYPTOPULSE_ENV=production

WORKDIR /app
RUN groupadd --system cryptopulse && useradd --system --gid cryptopulse cryptopulse
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY data/sample ./data/sample
COPY config ./config
COPY reports ./reports
RUN python -m pip install --no-cache-dir --upgrade pip && python -m pip install --no-cache-dir ".[api]"
RUN mkdir -p /app/var && chown -R cryptopulse:cryptopulse /app

USER cryptopulse
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["uvicorn", "cryptopulse.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
