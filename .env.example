# Required for the NewsAPI connector. Never commit your real value.
NEWS_API_KEY=replace_with_your_development_key

# Optional Phase 12 dashboard connection. Omit to use the synthetic demo.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins permitted by the local API.
CRYPTOPULSE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# development, test, or production. Production rejects wildcard/missing CORS origins.
CRYPTOPULSE_ENV=development
